* text=auto eol=lf
# Preserve exact linker bytes used for compatibility hashes on every host.
linker/*.ld -text whitespace=cr-at-eol
# Qualified profiles and descriptors retain their exact byte hashes.
profiles/*.json -text whitespace=cr-at-eol
profiles/*/content/*.json -text whitespace=cr-at-eol
# Unified diffs require a space prefix on empty context lines.
tools/gcc/patches/**/*.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
