// SDK native voice adapter for synthesis drum kits. Stock creates one machine object per
// voice index, 0..255, and calls it through an 11-entry method table, never
// checking for a missing one. Each index gets a small handle, and the machine's
// voiceCapacity voices go to handles as their notes start: a free voice, or the
// one whose note started longest ago, which first gets destroy for the note it
// held. A handle without a voice renders silence. This adapter maps those calls
// onto the machine's initialize/start/destroy/render callbacks. Only the SDK
// knows the stock pitch buffer, method offsets and symbol names.
#include "core.h"
#include "engine.cpp"
#include <opxy/q31.hpp>
#include "stock.hpp"
#include "synth_controls.hpp"
#include "drum_machines.hpp"
#include "drum_storage.hpp"
#include "stock_sample.hpp"
#include "sample_machines.hpp"
// Stock assembly imports use explicit names; all other C symbols keep the ABI prefix.
extern "C" {
void* @PREFIX@_factory(opxy::u32, opxy::u32) __asm__("@PREFIX@_factory");
const char* @PREFIX@_parameter_name(opxy::u32) __asm__("@PREFIX@_parameter_name");
extern const char @PREFIX@_name[] __asm__("@PREFIX@_name");
// The engine ID: an absolute symbol the linker supplies.
extern const char @PREFIX@_engine_id[] __asm__("@PREFIX@_engine_id");
}
using Voice = @NAMESPACE@::Voice;
using Shared = @NAMESPACE@::Shared;
// Stock's voice indices; every one gets a handle.
const opxy::u32 kVoiceIndices = 256;
struct Handle { const void* const* vtable; opxy::u32 slot, key, track; };  // slot: its voice plus one, or 0
struct Slot { Voice voice; opxy::u32 owner, started; };       // owner: a voice ID, or 0 when free
static Handle handles[kVoiceIndices];
static Slot voices[@CAPACITY@];
static opxy::u32 notes;  // counts note starts, to find the oldest
static Shared shared;
// Declared generic labels: @LABELS@
static_assert(sizeof(Voice) == @VOICE_BYTES@, "Declared voice size differs from the compiled type");
static_assert(alignof(Voice) == @VOICE_ALIGNMENT@, "Declared voice alignment differs from the compiled type");
static_assert(@SHARED_BYTES@ == 0 ? __is_empty(Shared) : sizeof(Shared) == @SHARED_BYTES@,
              "Declared shared size differs from the compiled type");
static const opxy::u32* const increments = reinterpret_cast<const opxy::u32*>(opxy::platform::kPitchIncrements);
// The alternate stock renderer prepares this gain/envelope vector but leaves
// its application to the drum DSP (stock Drumline consumes it at 11a0783e).
static const opxy::i32* const amplitude = reinterpret_cast<const opxy::i32*>(0x11905300);
// A stable nonzero voice ID: the stock voice index plus one.
static opxy::u32 owner(const Handle* handle) { return static_cast<opxy::u32>(handle - handles) + 1; }
// The voice a handle still holds, or none if its voice went to another note.
static Slot* held(const Handle* handle) {
    return handle->slot && voices[handle->slot - 1].owner == owner(handle) ? &voices[handle->slot - 1] : nullptr;
}
extern "C" {
extern const void* const @PREFIX@_vtable[];
// A note keeps its handle's voice or takes one: a free voice, else the one
// whose note started longest ago. A voice taken from another note is destroyed
// for that note first; a voice new to this handle starts zeroed and initialized.
int @PREFIX@_start(void* self, opxy::u32 key) {
    Handle* handle = static_cast<Handle*>(self);
    handle->key = key < 128 && handle->track < 8
        ? opxy::platform::sample_drum_key(key, sdk_sample_drum_octaves[handle->track]) : 53;
    const opxy::u32 id = owner(handle);
    Slot* slot = held(handle);
    if (!slot) {
        slot = &voices[0];
        for (opxy::u32 i = 0; i < @CAPACITY@; ++i) {
            if (!voices[i].owner) { slot = &voices[i]; break; }
            if (notes - voices[i].started > notes - slot->started) slot = &voices[i];
        }
        if (slot->owner) @NAMESPACE@::destroy(slot->voice, shared, slot->owner);
        // Storage starts zeroed for every owner; a voice need not be assignable.
        unsigned char* bytes = reinterpret_cast<unsigned char*>(&slot->voice);
        for (unsigned i = 0; i < sizeof(Voice); ++i) bytes[i] = 0;
        slot->owner = id;
        @NAMESPACE@::initialize(slot->voice, shared, id);
        handle->slot = static_cast<opxy::u32>(slot - voices) + 1;
    }
    slot->started = ++notes;
    @NAMESPACE@::start(slot->voice, shared, id);
    return 0;
}
// Stock's drum constructor calls +20 at 8d51a358 with key, velocity,
// region and track parameters. The contributor's start callback needs the key
// captured by the SDK and its stable owner, not stock's extra arguments.
static int start_drum(void* self, opxy::u32 key, opxy::u32,
                      const opxy::i32*, const opxy::i32*) {
    return @PREFIX@_start(self, key);
}
int @PREFIX@_destroy(void* self) {
    Handle* handle = static_cast<Handle*>(self);
    if (Slot* slot = held(handle)) {
        @NAMESPACE@::destroy(slot->voice, shared, slot->owner);
        slot->owner = 0;
    }
    handle->slot = 0;
    return 0;
}
void* @PREFIX@_factory(opxy::u32 index, opxy::u32 track) {
    if (index >= kVoiceIndices) return nullptr;
    Handle* handle = &handles[index];
    handle->vtable = @PREFIX@_vtable;
    handle->key = 53;
    handle->track = track;
    handle->slot = 0;
    return handle;
}
// The drum classifier sets voice+0x4e, selecting 8d51a684. Its call at
// 8d51a96a uses +12 with the payload in R2 and track parameters on the stack.
int @PREFIX@_render(void* self, opxy::i32* output, const opxy::i32* region,
                   const opxy::i32* parameters) {
    if (Slot* slot = held(static_cast<Handle*>(self))) {
        const Handle* handle = static_cast<const Handle*>(self);
        opxy::u8 raw[8];
        @NAMESPACE@::drum_defaults(handle->key, raw);
        if (region) opxy::platform::drum_unpack(region + 1, raw);
        if (raw[0] >= @MODEL_COUNT@) @NAMESPACE@::drum_defaults(handle->key, raw);
        // Track parameters apply after unpacking, never to the persisted words.
        opxy::u8 played[8];
        opxy::platform::drum_offset(raw, parameters, @MODEL_COUNT@, played);
        opxy::i32 live[8];
        for (opxy::u32 i = 0; i < 8; ++i) {
            const opxy::u32 value = played[i];
            live[i] = i == 0 ? opxy::platform::drum_model_q31(value, @MODEL_COUNT@)
                : value == 127 ? 0x7fffffff : static_cast<opxy::i32>(value << 24);
        }
        // Unlike the normal synth renderer, 8d51a850..854 publishes phase
        // increments shifted right by 16. Restore the public Pitch units.
        opxy::u32 pitch[opxy::block_frames];
        for (unsigned i = 0; i < opxy::block_frames; ++i) pitch[i] = increments[i] << 16;
        @NAMESPACE@::render(slot->voice, shared, slot->owner, output, live, pitch);
        for (unsigned i = 0; i < opxy::block_frames; ++i)
            output[i] = opxy::q31::multiply(output[i], amplitude[i]);
    } else {
        for (unsigned i = 0; i < opxy::block_frames; ++i) output[i] = 0;
    }
    return 0;
}
// +8 belongs to stock's other renderer. Never leave its output scratch stale
// if it is called without the drum payload ABI.
static int render_normal(void*, opxy::i32* output, const opxy::i32*) {
    for (unsigned i = 0; i < opxy::block_frames; ++i) output[i] = 0;
    return 0;
}
// Stock's alternate renderer retires the note when +24 reports inactive.
// Retain our allocated voice until stock's amplitude envelope ends the note;
// stolen or destroyed handles can be retired immediately.
static int active(void* self) { return held(static_cast<Handle*>(self)) ? 1 : 0; }
static int zero() { return 0; }
static void noop() {}
const char @PREFIX@_name[] = "@NAME@";
// Stable parameter-slot names for LFO destinations and other stock callers.
// The engine screen maps its four positions in sdk_synth_title instead.
const char* @PREFIX@_parameter_name(opxy::u32 index) {
    return sdk_drum_title(static_cast<opxy::u32>(reinterpret_cast<__UINTPTR_TYPE__>(@PREFIX@_engine_id)), index);
}
void @PREFIX@_drum_defaults(opxy::u32 key, opxy::u8* values) __asm__("@PREFIX@_drum_defaults");
const char* @PREFIX@_drum_label(opxy::u32 model, opxy::u32 slot) __asm__("@PREFIX@_drum_label");
const char* @PREFIX@_drum_model_name(opxy::u32 model) __asm__("@PREFIX@_drum_model_name");
opxy::u32 @PREFIX@_drum_count(opxy::u32 model) __asm__("@PREFIX@_drum_count");
void @PREFIX@_drum_defaults(opxy::u32 key, opxy::u8* values) { @NAMESPACE@::drum_defaults(key, values); }
const char* @PREFIX@_drum_label(opxy::u32 model, opxy::u32 slot) { return @NAMESPACE@::parameter_name(model, slot); }
const char* @PREFIX@_drum_model_name(opxy::u32 model) { return @NAMESPACE@::model_name(model); }
opxy::u32 @PREFIX@_drum_count(opxy::u32 model) { return @NAMESPACE@::parameter_count(model); }
const void* const @PREFIX@_vtable[11] = {
    reinterpret_cast<const void*>(&@PREFIX@_destroy), reinterpret_cast<const void*>(&@PREFIX@_destroy),
    reinterpret_cast<const void*>(&render_normal), reinterpret_cast<const void*>(&@PREFIX@_render),
    reinterpret_cast<const void*>(&@PREFIX@_start), reinterpret_cast<const void*>(&start_drum),
    reinterpret_cast<const void*>(&active), reinterpret_cast<const void*>(&noop),
    reinterpret_cast<const void*>(&zero), reinterpret_cast<const void*>(&zero),
    reinterpret_cast<const void*>(opxy::platform::kVoiceDefaultMethod)
};
}
