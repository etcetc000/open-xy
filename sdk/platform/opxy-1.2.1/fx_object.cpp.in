// SDK native ABI for a send effect. Only the SDK knows the stock FX object
// layout and method offsets; the effect provides State, initialize and process
// (opxy/effect.hpp). Stock constructs effects in place inside a 480-byte slot
// on the audio thread and never runs a destructor.
// fx.cpp includes its own core.h, resolved next to it rather than on the
// shared include path where another machine's core.h may come first.
#include "fx.cpp"
extern "C" {
void* @PREFIX@_fx_factory(void*) __asm__("@PREFIX@_fx_factory");
const char* @PREFIX@_fx_parameter_name(opxy::u32) __asm__("@PREFIX@_fx_parameter_name");
extern const char @PREFIX@_fx_name[] __asm__("@PREFIX@_fx_name");
}
using State = @NAMESPACE@::State;
@OBJECT@
static_assert(alignof(State) <= opxy::effect_state_alignment, "Effect state alignment exceeds the FX object header");
static_assert(sizeof(Object) <= 480, "Stock FX slots hold 480 bytes");
static_assert(__builtin_offsetof(Object, state) == 4, "FX object header mismatch");
extern "C" {
extern const void* const @PREFIX@_fx_vtable[];
static void* destroy(void* self) { return self; }
static int zero() { return 0; }
static void noop() {}
// +0x14: called after construction, and again on an engine reset, with the
// stock slot index: the track's, so 14 and 15 are the two sends.
static void init(void* self, opxy::u32 slot) {
    Object* object = static_cast<Object*>(self);
@INIT@
    @NAMESPACE@::initialize(object->state);
}
// +0x10: one 64-sample block, left and right processed in place.
static void process(void* self, opxy::i32* left, opxy::i32* right, const opxy::i32* parameters) {
    Object* object = static_cast<Object*>(self);
    @NAMESPACE@::process(object->state, @BUFFER@@TRANSPORT@left, right, parameters);
}
void* @PREFIX@_fx_factory(void* storage) {
    if (!storage) return nullptr;
    Object* object = static_cast<Object*>(storage);
    object->state = State();
@RESET@
    object->vtable = @PREFIX@_fx_vtable;
    return object;
}
// +0x1c: stock queries the dry level separately from the wet DSP. Stock delay
// (8d501128) and reverb (8d501966) return parameter word 3; the mixer queries it
// at 8d510d5e and 8d510df4. Return the declared normalized Q31 control
// unchanged, or unity (stock's absent-object fallback) when no Dry is declared.
static opxy::i32 dry_level(void*, const opxy::i32* parameters) {
    (void)parameters;
    return @DRY_LEVEL@;
}
const char @PREFIX@_fx_name[] = "@NAME@";
const char* @PREFIX@_fx_parameter_name(opxy::u32 index) {
    static const char* const labels[] = {@LABELS@};
    return index < sizeof(labels) / sizeof(labels[0]) ? labels[index] : "";
}
// +0x00/+0x04 destructors, +0x08 unused, +0x0c insert process (unused by
// send effects), +0x10 send process, +0x14 init, +0x18 insert-active query,
// +0x1c source dry-level query (object, parameter vector) -> Q31.
const void* const @PREFIX@_fx_vtable[8] = {
    reinterpret_cast<const void*>(&destroy), reinterpret_cast<const void*>(&destroy),
    reinterpret_cast<const void*>(&noop), reinterpret_cast<const void*>(&zero),
    reinterpret_cast<const void*>(&process), reinterpret_cast<const void*>(&init),
    reinterpret_cast<const void*>(&zero), reinterpret_cast<const void*>(&dry_level)
};
}
