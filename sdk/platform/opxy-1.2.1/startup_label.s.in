/* Generated by tooling/startup_label.py with the release version.
 * Only the version-label call in stock OS startup, after firmware.version
 * parsing. The earlier startup status draw and protocol metadata stay stock.
 * Entered by an absolute jump with the original caller frame still active.
 * See docs/abi-1.2.1.md.
 */
.section .text.kit_startup_label,"ax",@progbits
.align 2
.global kit_startup_label
.type kit_startup_label, STT_FUNC
kit_startup_label:
    R2 = [SP + 0x48];
    R0.H = kit_startup_label_text;
    R0.L = kit_startup_label_text;
    /* BF70x CALL.a 0x8c0b7078: existing centered startup text renderer. */
    .short 0xde00, 0x8c0b, 0x7078, 0
    /* BF70x JUMP.a 0x8c0b85e6: next stock CALL overwrites RETS. */
    .short 0xdc00, 0x8c0b, 0x85e6, 0
.size kit_startup_label, .-kit_startup_label

.section .rodata.kit_startup_label,"a",@progbits
.global kit_startup_label_text
.type kit_startup_label_text, STT_OBJECT
kit_startup_label_text:
    .asciz "@LABEL@"
.size kit_startup_label_text, .-kit_startup_label_text
/* Explicit bytes keep GNU binary output and the browser's aligned image equal. */
.balign 4, 0
