// Stock OS 1.2.1 side of checked registration: record tables, name maps,
// resolvers, registrars and screen page slots. Engine and effect records and
// page slots are the relocated tables (tooling/stock_tables.py).
#include "registration.hpp"
#include "stock.hpp"

using opxy::u32;
using opxy::platform::Record;
using opxy::platform::Screen;
using namespace opxy::platform::registry;
using opxy::platform::stock;

// The engine validity check every engine lookup calls (stock_tables.ENGINE_BOUND)
// loads R1 = 33 and sets CC = R0 < R1; imm7 cannot hold the relocated count, so a
// call replaces both and does the same against it. The check's UNLINK restores the
// RETS the call replaces; nothing else is touched.
asm(R"(
    .pushsection .text
    .align 2
    .global sdk_engine_bound
    .type sdk_engine_bound, STT_FUNC
sdk_engine_bound:
    R1 = @ENGINE_LIMIT@ (X);
    CC = R0 < R1;
    RTS;
    .size sdk_engine_bound, .-sdk_engine_bound
    .popsection
)");

namespace {

void add_engine(const Record& r, u32 id, u32 page) {
    stock<void(u32, const char*, const char*, const char*, u32, u32)>(0x8d50651c)(
        id, r.name, r.factory, r.parameter_name, r.flag, page);
}
void add_effect(const Record& r, u32 id, u32 page) {
    stock<void(u32, const char*, const char*, const char*, u32)>(0x8d5066a4)(
        id, r.name, r.factory, r.parameter_name, page);
}

// Records, limit, resolver miss, name map, name resolver, registrar.
const Registry kEngines = {@ENGINE_RECORDS@, @ENGINE_LIMIT@, @ENGINE_SENTINEL@, 0x08039160, 0x8d506cd8, add_engine};
const Registry kEffects = {@EFFECT_RECORDS@, @EFFECT_LIMIT@, @EFFECT_SENTINEL@, 0x08039148, 0x8d506db4, add_effect};
// Page limit, slot getter (initializes), slot table, its initialized byte.
const Pages kPages = {@PAGE_LIMIT@, 0x8d52077c, @SCREEN_SLOTS@, 0x0803bf1c};
}

int sdk_register_engine(const Record* r) { return add(kEngines, kPages, *r); }
int sdk_register_effect(const Record* r) { return add(kEffects, kPages, *r); }
int sdk_register_screen(const Record* r, const Screen* screen) { return add_screen(kPages, *r, *screen); }
int sdk_engine_ready(const Record* r, const Screen* screen) { return ready(kEngines, kPages, *r, screen); }
int sdk_effect_ready(const Record* r) { return ready(kEffects, kPages, *r, nullptr); }
int sdk_stock_engine_known(const void* name) { return known(kEngines, static_cast<const StockString*>(name)); }
int sdk_name_matches(const Record* r, const void* string) {
    return name_matches(*r, static_cast<const StockString*>(string));
}
