// SDK native ABI for a sample-playback engine (stock record flag 1).
// The stock voice allocator acquires the track's cached sample, publishes it
// (stock.hpp kCurrentSample) and then calls the engine factory; the allocation
// record holds the reference. The engine sees only a validated read-only SampleView.
#include "sample.cpp"
#include "sample_machines.hpp"
#include "stock_sample.hpp"
#include "sample_cache.hpp"
#include "sample_preview.hpp"
#include "stock.hpp"
#include <opxy/transport.hpp>
extern "C" {
void* @PREFIX@_factory(opxy::u32, opxy::u32) __asm__("@PREFIX@_factory");
const char* @PREFIX@_parameter_name(opxy::u32) __asm__("@PREFIX@_parameter_name");
extern const char @PREFIX@_name[] __asm__("@PREFIX@_name");
// The engine ID: an absolute symbol the linker supplies.
extern const char @PREFIX@_engine_id[] __asm__("@PREFIX@_engine_id");
}
using Voice = @NAMESPACE@::Voice;
struct Slot {
    const void* const* vtable;
    Voice voice;
    opxy::platform::SamplePreview preview;
    opxy::platform::SamplePreviewRange slice;
    opxy::u32 frames;
    const void* sample_object;
    const opxy::SampleAnalysis* analysis;
    unsigned char track, key, retry;
    opxy::u32 tuning;
    opxy::i32 pitch_cents;
    opxy::i32 drum_transpose;
    bool started;
};
static Slot voices[@CAPACITY@];
static Slot* active[@CHOKE@ ? 8 : 1][@CHOKE@ ? 128 : 1];
static void clear_owner(Slot* slot) {
    if (@CHOKE@ && slot->started && slot->track < 8 && slot->key < 128 &&
        active[slot->track][slot->key] == slot) active[slot->track][slot->key] = nullptr;
}
static_assert(__builtin_offsetof(Slot, voice) == 4, "Native header offset mismatch");
static const opxy::u32* const increments = reinterpret_cast<const opxy::u32*>(opxy::platform::kPitchIncrements);
static opxy::u32 engine_id() { return static_cast<opxy::u32>(reinterpret_cast<__UINTPTR_TYPE__>(@PREFIX@_engine_id)); }
static const void* published_sample() {
    return *reinterpret_cast<const void* const volatile*>(opxy::platform::kCurrentSample);
}

// Audio-role globals.
static const opxy::u32 kTrackParameters = 0x84eab39c;  // per-track words, stride 0xe8 (stock 8d518d94)
static const opxy::u32 kTransposeParameter = 0xd0;
static const opxy::u32 kVoiceRegion = 0x0803b9c4;      // region record of the voice being rendered

static opxy::i32 track_transpose(opxy::u32 track) {
    if (track >= opxy::platform::kTracks) return 0;
    return opxy::platform::sample_track_transpose(
        static_cast<opxy::i32>(opxy::platform::word(kTrackParameters + track * 0xe8u + kTransposeParameter)));
}

extern "C" {
extern const void* const @PREFIX@_vtable[];
#if @PAD_SETTINGS@
opxy::PadSettings @PREFIX@_sample_defaults() __asm__("@PREFIX@_sample_defaults");
opxy::PadSettings @PREFIX@_sample_assign(const opxy::SampleAssignment* input) __asm__("@PREFIX@_sample_assign");
opxy::PadSettings @PREFIX@_sample_defaults() { return @NAMESPACE@::sample_defaults(); }
opxy::PadSettings @PREFIX@_sample_assign(const opxy::SampleAssignment* input) { return @NAMESPACE@::sample_assign(*input); }
#endif
#if @DRUM_CONTROLS@
void @PREFIX@_drum_control(opxy::PadSettings*, const opxy::DrumControl*) __asm__("@PREFIX@_drum_control");
void @PREFIX@_drum_panel(opxy::PadSettings, const opxy::SampleRegion*, const opxy::i32*, opxy::DrumPanel*) __asm__("@PREFIX@_drum_panel");
void @PREFIX@_drum_control(opxy::PadSettings* value, const opxy::DrumControl* event) { @NAMESPACE@::drum_control(*value, *event); }
void @PREFIX@_drum_panel(opxy::PadSettings value, const opxy::SampleRegion* saved, const opxy::i32* parameters,
                          opxy::DrumPanel* panel) { @NAMESPACE@::drum_panel(value, *saved, parameters, *panel); }
#endif
#if @SLICE_TIMING@
void @PREFIX@_slice_clock(const opxy::SampleSlice*, opxy::SampleSliceRate*) __asm__("@PREFIX@_slice_clock");
void @PREFIX@_slice_clock(const opxy::SampleSlice* input, opxy::SampleSliceRate* output) {
    @NAMESPACE@::slice_clock(*input, *output);
}
#endif
#if @ANALYSIS@
// One preparation at a time, on the stock file worker (sample_cache.cpp).
opxy::u32 @PREFIX@_analysis_words(const opxy::SampleView*) __asm__("@PREFIX@_analysis_words");
opxy::u32 @PREFIX@_prepare_begin(const opxy::SampleView*, opxy::u32*, opxy::u32) __asm__("@PREFIX@_prepare_begin");
opxy::u32 @PREFIX@_prepare_step(opxy::u32, opxy::u32*) __asm__("@PREFIX@_prepare_step");
opxy::u32 @PREFIX@_prepared(opxy::SampleAnalysis*) __asm__("@PREFIX@_prepared");
static @NAMESPACE@::Preparation preparation;
opxy::u32 @PREFIX@_analysis_words(const opxy::SampleView* sample) { return @NAMESPACE@::analysis_words(*sample); }
opxy::u32 @PREFIX@_prepare_begin(const opxy::SampleView* sample, opxy::u32* storage, opxy::u32 words) {
    preparation = @NAMESPACE@::Preparation();
    return @NAMESPACE@::prepare_begin(preparation, *sample, storage, words);
}
opxy::u32 @PREFIX@_prepare_step(opxy::u32 frames, opxy::u32* cursor) {
    return @NAMESPACE@::prepare_step(preparation, frames, *cursor);
}
opxy::u32 @PREFIX@_prepared(opxy::SampleAnalysis* out) { return @NAMESPACE@::prepared(preparation, *out); }
#endif
// The pad's saved settings, or the machine's defaults when it has none.
static opxy::PadSettings settings(const opxy::i32* region) {
#if @PAD_SETTINGS@
    const opxy::platform::SavedSettings saved =
        opxy::platform::sample_settings(region ? static_cast<opxy::u32>(region[opxy::platform::audio_region::kFade]) : 0);
    return saved.saved ? saved.value : @NAMESPACE@::sample_defaults();
#else
    return 0;
#endif
}
// Stock +16 note-start receives the parent note in R1. Preparing a factory
// never chokes a playing voice; only an actual start takes ownership.
static int start(void* self, opxy::u32 key) {
    Slot* slot = static_cast<Slot*>(self);
    clear_owner(slot);
    // Choke ownership needs a track and key; without choke every note plays.
    const bool keyed = slot->track < 8 && key < 128;
    slot->started = keyed || !@CHOKE@;
    // The GUI's sample lookup publishes the track octave. Calling its project
    // getters here can assert on the audio role's unavailable pattern state.
    slot->key = keyed ? (@DRUM_KEYS@ ? opxy::platform::sample_drum_key(
        key, sdk_sample_drum_octaves[slot->track]) : key) : 128;
    slot->drum_transpose = keyed && @DRUM_KEYS@ ? opxy::i32(key) - opxy::i32(slot->key) : 0;
    if (slot->started) {
        if (@CHOKE@ && keyed) active[slot->track][slot->key] = slot;
        @NAMESPACE@::start(slot->voice);
    }
    return 0;
}
static int destroy(void* self) {
    Slot* slot = static_cast<Slot*>(self);
    clear_owner(slot);
    slot->started = false;
    slot->analysis = nullptr;
    return 0;
}
void* @PREFIX@_factory(opxy::u32 index, opxy::u32 track) {
    if (index >= @CAPACITY@) return nullptr;
    Slot* slot = &voices[index];
    clear_owner(slot);
    slot->track = track < 8 ? static_cast<unsigned char>(track) : 255;
    slot->tuning = 0;
    slot->pitch_cents = 0;
    slot->drum_transpose = 0;
    slot->key = 128;
    slot->started = false;
    slot->retry = 0;
    slot->sample_object = published_sample();
    const opxy::SampleView sample = opxy::platform::stock_sample_view(slot->sample_object);
    const opxy::platform::SamplePreviewRange* source = sdk_sample_slice_preview(engine_id(), track);
    slot->slice = source ? *source : opxy::platform::SamplePreviewRange{};
    const bool processed = @SLICE_TIMING@ && source && source->processed &&
        source->frames == sample.frames && source->begin < source->end && source->end <= sample.frames;
    slot->slice.processed = processed;
    slot->preview = opxy::platform::sample_preview(sample, processed ? nullptr : source);
    slot->frames = sample.frames;
    slot->analysis = @ANALYSIS@ && !slot->preview.active ? sdk_sample_cache_find(slot->sample_object, engine_id()) : nullptr;
    @NAMESPACE@::initialize(slot->voice, sample);
    slot->vtable = @PREFIX@_vtable;
    return slot;
}
static int render(void* self, opxy::i32* output, const opxy::i32* parameters) {
    Slot* slot = static_cast<Slot*>(self);
    if (!slot->started || (@CHOKE@ && active[slot->track][slot->key] != slot)) {
        for (unsigned i = 0; i < (@STEREO@ ? 128u : 64u); ++i) output[i] = 0;
        return 0;
    }
    if (slot->preview.active) {
        const opxy::i32* region = *reinterpret_cast<const opxy::i32* const volatile*>(kVoiceRegion);
        const opxy::u32 level = region && region[opxy::platform::audio_region::kLevel] > 0 ?
            static_cast<opxy::u32>(region[opxy::platform::audio_region::kLevel]) : 0;
        opxy::platform::render_sample_preview(slot->preview, output, @STEREO@ ? 2u : 1u, level);
        return 0;
    }
    if (@ANALYSIS@ && !slot->analysis) {
        if (slot->retry) --slot->retry;
        else {
            // Every 8 blocks while pending; every 256 once preparation has failed.
            slot->analysis = sdk_sample_cache_find(slot->sample_object, engine_id());
            slot->retry = !slot->analysis && sdk_sample_cache_failed(slot->sample_object, engine_id()) ? 255 : 7;
        }
    }
    if (slot->slice.processed) {
        const opxy::platform::SamplePreviewRange& source = slot->slice;
        const opxy::SampleBlock block{output, source.parameters, increments,
            opxy::Transport{source.bpm_x10, 0, false},
            opxy::SampleRegion{source.begin, source.end, source.level, false, source.pitch_cents},
            slot->analysis, source.settings, @STEREO@ ? 2u : 1u, source.track_transpose, 0, true};
        @NAMESPACE@::render_sample(slot->voice, block);
        return 0;
    }
    const opxy::i32* region = *reinterpret_cast<const opxy::i32* const volatile*>(kVoiceRegion);
    const opxy::u32 factor = region ? static_cast<opxy::u32>(region[opxy::platform::audio_region::kTuning]) : 0;
    if (factor != slot->tuning) {
        slot->tuning = factor;
        slot->pitch_cents = opxy::platform::sample_pitch_cents(factor);
    }
    // The drum page edits outer markers only; hidden inner loop markers do not narrow playback.
    const opxy::SampleBlock block{output, parameters, increments, opxy::platform::audio_transport(),
        opxy::platform::sample_region(region, slot->frames, slot->pitch_cents, @DRUM_CONTROLS@ != 0), slot->analysis,
        settings(region), @STEREO@ ? 2u : 1u, track_transpose(slot->track), slot->drum_transpose, false};
    @NAMESPACE@::render_sample(slot->voice, block);
    return 0;
}
static int zero() { return 0; }
// Stock sampler +32 selects the interleaved stereo mix path.
static int stereo() { return @STEREO@; }
static void noop() {}
const char @PREFIX@_name[] = "@NAME@";
const char* @PREFIX@_parameter_name(opxy::u32 index) {
    static const char* const labels[] = {@LABELS@};
    return index < sizeof(labels) / sizeof(labels[0]) ? labels[index] : "";
}
const void* const @PREFIX@_vtable[11] = {
    reinterpret_cast<const void*>(&destroy), reinterpret_cast<const void*>(&destroy),
    reinterpret_cast<const void*>(&render), reinterpret_cast<const void*>(&noop),
    reinterpret_cast<const void*>(&start), reinterpret_cast<const void*>(&noop),
    reinterpret_cast<const void*>(&zero), reinterpret_cast<const void*>(&noop),
    reinterpret_cast<const void*>(&stereo), reinterpret_cast<const void*>(&zero),
    reinterpret_cast<const void*>(opxy::platform::kVoiceDefaultMethod)
};
}
