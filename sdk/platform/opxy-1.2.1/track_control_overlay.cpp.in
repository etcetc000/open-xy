// The SDK's overlay on every page: a screen object in the last page slot
// (@PAGE_LIMIT@ - 1), which no machine is given. The compositor (8d5213f4)
// paints a slot that is the current page, or whose method-table entry +8 says
// so; stock overlays such as the octave indicator use that. This object answers
// yes while the snapshot menu is open, and paints it over whatever page is shown.
#include "screen.hpp"
#include "registration.hpp"
#include "track_control.hpp"
#include "snapshots.hpp"

using opxy::u32;
using opxy::i32;

namespace {
using namespace opxy::screen;
namespace platform = opxy::platform;

const u32 kPage = @PAGE_LIMIT@ - 1;
const char kAsset[] = "openxy_overlay.svg";

// The snapshot menu's nodes (track_control_overlay.svg): a cover and stock's
// card, each slot's box and its numeral in two shades, one black square and one
// light numeral moved to the selected slot, the state, and the bottom row.
const u32 kSlots = 10;
enum MenuNode : u32 {
    kCover, kCard, kBox0, kDark0 = kBox0 + kSlots, kFaint0 = kDark0 + kSlots, kSel = kFaint0 + kSlots,
    kSelLabel, kDivider, kState, kTracks, kHere, kStrip, kM0, kMenuNodes = kM0 + 4
};
const char* const kMenuIds[kMenuNodes] = {
    "snap_cover", "snap_card",
    "snap_box_0", "snap_box_1", "snap_box_2", "snap_box_3", "snap_box_4",
    "snap_box_5", "snap_box_6", "snap_box_7", "snap_box_8", "snap_box_9",
    "snap_dark_0", "snap_dark_1", "snap_dark_2", "snap_dark_3", "snap_dark_4",
    "snap_dark_5", "snap_dark_6", "snap_dark_7", "snap_dark_8", "snap_dark_9",
    "snap_faint_0", "snap_faint_1", "snap_faint_2", "snap_faint_3", "snap_faint_4",
    "snap_faint_5", "snap_faint_6", "snap_faint_7", "snap_faint_8", "snap_faint_9",
    "snap_sel", "snap_sel_label", "snap_divider", "snap_state", "snap_tracks", "snap_here",
    "snap_strip", "snap_m0", "snap_m1", "snap_m2", "snap_m3"};
// The squares' pitch, in Q10 pixels, across and down (two rows of five).
const i32 kPitchX = 40 << 10, kPitchY = 40 << 10, kAway = 640 << 10;

struct Object {
    Base base;
    Leaf* menu[kMenuNodes];   // the menu's nodes, any kind
    i32 home[kMenuNodes][2];  // each menu node's own translation, as loaded
    u32 bound;
    platform::MenuView menu_shown;  // the menu state last applied
    bool menu_drawn;                // anything of the menu may be on screen
};
Object overlay;

// A menu node at its own place moved by (dx, dy), or off screen.
void place(Object* o, u32 i, bool on, i32 dx = 0, i32 dy = 0) {
    Leaf* node = o->menu[i];
    if (!node) return;
    const u32 at[2] = {6, 7};
    const i32 value[2] = {o->home[i][0] + (on ? dx : kAway), o->home[i][1] + (on ? dy : 0)};
    set_words(node, at, value);
}
void text(Object* o, u32 i, const char* value) {
    if (Leaf* node = text_node(o->menu[i])) set_text(node, value);
}
// A slot's label, 1-9 then 0.
char label(u32 slot) { return static_cast<char>('0' + (slot + 1) % 10); }
// Short words: the column is about 90 pixels at 18 px.
void apply_menu(Object* o, const platform::MenuView& v) {
    if (o->menu_drawn == v.open && (!v.open || v == o->menu_shown)) return;
    for (u32 i = 0; i < kMenuNodes; ++i) place(o, i, false);
    o->menu_shown = v;
    o->menu_drawn = v.open;
    if (!v.open) return;
    const u32 fixed[] = {kCover, kCard, kDivider, kState, kTracks};
    for (u32 i = 0; i < sizeof(fixed) / sizeof(fixed[0]); ++i) place(o, fixed[i], true);
    for (u32 s = 0; s < kSlots; ++s) {
        place(o, kBox0 + s, true);
        place(o, (v.taken >> s & 1 ? kDark0 : kFaint0) + s, true);
    }
    const i32 dx = static_cast<i32>(v.selected % 5) * kPitchX, dy = static_cast<i32>(v.selected / 5) * kPitchY;
    place(o, kSel, true, dx, dy);
    place(o, kSelLabel, true, dx, dy);
    const char selected[2] = {label(v.selected), 0};
    text(o, kSelLabel, selected);
    if (v.current < kSlots)
        place(o, kHere, true, static_cast<i32>(v.current % 5) * kPitchX, static_cast<i32>(v.current / 5) * kPitchY);
    // What is current: what the last action did, for a moment; else the slot the
    // tracks hold, the last slot since edited, or none.
    char line[12] = {0};
    const char* what = nullptr;
    u32 slot = kSlots;
    if (v.flash == platform::kFlashSaved) { what = "saved "; slot = v.flash_slot; }
    else if (v.flash == platform::kFlashLoaded) { what = "loaded "; slot = v.flash_slot; }
    else if (v.flash == platform::kFlashCleared) { what = "cleared "; slot = v.flash_slot; }
    else if (v.flash == platform::kFlashClearedAll) what = "all clear";
    else if (v.current < kSlots) { line[0] = label(v.current); what = " active"; }
    else if (v.active < kSlots) { line[0] = label(v.active); what = " edited"; }
    else what = "unsaved";
    u32 n = line[0] ? 1 : 0;
    for (const char* c = what; *c && n < 10; ++c) line[n++] = *c;
    if (slot < kSlots && n < 11) line[n++] = label(slot);
    line[n] = 0;
    text(o, kState, line);
    // The selected slot: empty, saved, or how many tracks a load would restore.
    const bool saved = v.taken >> v.selected & 1;
    const char fits[9] = {'f', 'i', 't', 's', ' ', static_cast<char>('0' + v.fits), '/', '8', 0};
    text(o, kTracks, !saved ? "empty" : v.fits == 8 ? "saved" : fits);
    if (v.strip) {
        place(o, kStrip, true);
        for (u32 m = 0; m < 4; ++m) place(o, kM0 + m, true);
    }
}

void bind(Object* o) {
    if (o->bound || !o->base.svg) return;
    for (u32 i = 0; i < kMenuNodes; ++i) {
        o->menu[i] = static_cast<Leaf*>(find(&o->base, kMenuIds[i]));
        if (o->menu[i] && !path_node(o->menu[i]) && !text_node(o->menu[i])) o->menu[i] = 0;
        o->home[i][0] = o->menu[i] ? o->menu[i]->matrix[6] : 0;
        o->home[i][1] = o->menu[i] ? o->menu[i]->matrix[7] : 0;
    }
    o->bound = 1;
    o->menu_drawn = true;  // as loaded, every node shows: the first apply hides them
    platform::MenuView closed = {};
    apply_menu(o, closed);
}

void destroy(Object* o) { base_destroy(&o->base); }
// Entry +8: paint this slot now.
u32 visible(Object* o, u32) {
    // Shown while the menu is open, or just closed (one more frame hides it).
    return platform::snapshot_menu_open() || o->menu_drawn;
}
void frame(Object* o, i32 elapsed) {
    bind(o);
    platform::snapshot_menu_frame(elapsed);
    platform::MenuView view = {};
    if (platform::snapshot_menu_open()) view = platform::snapshot_menu_view();
    if (o->bound) apply_menu(o, view);
    draw(&o->base);
}
void init(Object* o) { bind(o); }

struct VTable {
    void (*destroy)(Object*);
    void (*destroy_delete)(Object*);
    u32 (*visible)(Object*, u32);
    void (*frame)(Object*, i32);
    void (*init)(Object*);
    const void* stock20;
};
const VTable kVTable = {destroy, destroy, visible, frame, init, reinterpret_cast<const void*>(0x8c0867f0)};

char* construct(char* state, u32 page) {
    Object* o = reinterpret_cast<Object*>(state);
    base_construct(&o->base, page, kAsset);
    o->base.vtable = &kVTable;
    return state;
}
}

// GUI role, after the machines' screens: only a collection with track control
// takes the slot.
extern "C" void sdk_overlay_startup() {
    if (!sdk_control_machine_count) return;
    const platform::Record record = {nullptr, nullptr, nullptr, nullptr, reinterpret_cast<const char*>(kPage), 0};
    const platform::Screen screen = {reinterpret_cast<char*>(&overlay), sizeof(overlay),
                                     reinterpret_cast<const char*>(&kVTable), kAsset, construct};
    sdk_register_screen(&record, &screen);
}
