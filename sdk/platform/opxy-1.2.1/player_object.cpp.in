// SDK native ABI for a note player. Only the SDK knows the stock player object
// and its method table; the player provides State, press and release
// (opxy/player.hpp). Type, routing mode, note-on and note-off belong to the
// player bridge (players.cpp); its other methods, the
// clocked step that plays chord records among them, stay stock.
#include "player.cpp"
#include "players.hpp"
#include "stock.hpp"
extern "C" {
const opxy::platform::Player* @PREFIX@_player() __asm__("@PREFIX@_player");
// The stock type: an absolute symbol the linker supplies.
extern const char @PREFIX@_player_id[] __asm__("@PREFIX@_player_id");
@PAGE_DECLARATIONS@
}
using State = @NAMESPACE@::State;
static_assert(sizeof(State) <= opxy::player::state_bytes, "Player state exceeds the SDK state area");
static_assert(alignof(State) <= opxy::player::state_alignment, "Player state alignment exceeds the SDK state area");
namespace {
using opxy::u32;
State& state(void* object) { return *static_cast<State*>(opxy::platform::player_state(object)); }
template<class S> auto next_update(S& s, const opxy::player::Controls& c,
                                  opxy::player::Update& u, int) -> decltype(update(s, c, u)) {
    return update(s, c, u);
}
template<class S> bool next_update(S&, const opxy::player::Controls&, opxy::player::Update&, long) { return false; }
template<class S> auto clear_state(S& s, int) -> decltype(reset(s), void()) { reset(s); }
template<class S> void clear_state(S& s, long) { __builtin_memset(&s, 0, sizeof s); }
void apply_updates(void* object) {
    const auto controls = opxy::platform::player_controls(object);
    opxy::player::Update change;
    for (u32 i = 0; i < 8 && next_update(state(object), controls, change, 0); ++i)
        opxy::platform::update_plan(object, change);
}
}
extern "C" {
extern const void* const @PREFIX@_player_vtable[16];
// +0x08: the stock player type.
static u32 type(void*) { return static_cast<u32>(reinterpret_cast<__UINTPTR_TYPE__>(@PREFIX@_player_id)); }
// +0x0c: stock uses this query to flag live/sequenced notes with its special
// playback mode. Maestro reads encoder 4 here; a player's controls belong
// only to that machine (Chords uses it for spread). Keep ordinary routing.
static u32 routing_mode(void*) { return 0; }
// +0x14: note-on (object, note, 0, flag, velocity) from the sequencer, live
// or played back. Returning 1 takes the note; 0 lets the instrument play it.
static u32 press(void* object, u32 note, u32, u32, u32 velocity) {
    opxy::player::Plan plan;
    if (!@NAMESPACE@::press(state(object), opxy::platform::player_controls(object), note, velocity, plan)) return 0;
    opxy::platform::play_plan(object, note, plan);
    apply_updates(object);
    return 1;
}
// +0x18: note-off (object, note). Stock Maestro releases the chord whose root it is.
// The key is up either way, so no later update can start it.
static void release(void* object, u32 note) {
    if (!@NAMESPACE@::release(state(object), note))
        opxy::platform::stock<void(void*, u32)>(opxy::platform::kMaestroRelease)(object, note);
    opxy::platform::player_release(object, note);
    apply_updates(object);
}
static void reset_player(void* object) {
    opxy::platform::stock<void(void*)>(opxy::platform::kMaestroReset)(object);
    opxy::platform::player_reset(object);
    clear_state(state(object), 0);
}
static void all_off(void* object) {
    opxy::platform::stock<void(void*)>(opxy::platform::kMaestroAllOff)(object);
    opxy::platform::player_reset(object);
    clear_state(state(object), 0);
}
// +0x2c: stock's player clock steps an object only while this answers nonzero,
// and Maestro answers whether it holds chord records. A key the player took
// keeps the steps coming too, so a generator that took a key silently, or is
// resting after an empty Replace, still reaches its next step. Stock's step
// returns at once when there are no records.
static u32 active(void* object) {
    return opxy::platform::stock<u32(void*)>(opxy::platform::kMaestroActive)(object) ||
           opxy::platform::player_holds(object);
}
// Run control-driven edits on the same role as note input and stock stepping,
// before sounding the next tones. The GUI never edits chord records or State.
// The step count moves first, so this step's updates see it.
static void step_player(void* object) {
    opxy::platform::player_step(object);
    apply_updates(object);
    opxy::platform::stock<void(void*)>(opxy::platform::kMaestroStep)(object);
}
// Stock Maestro's method table with type, mode, note-on, note-off, reset,
// all-notes-off, the activity query and step replaced.
const void* const @PREFIX@_player_vtable[16] = {
    reinterpret_cast<const void*>(0x8d57d7b4), reinterpret_cast<const void*>(0x8d57d834),
    reinterpret_cast<const void*>(&type), reinterpret_cast<const void*>(&routing_mode),
    reinterpret_cast<const void*>(0x8d57d3d8), reinterpret_cast<const void*>(&press),
    reinterpret_cast<const void*>(&release), reinterpret_cast<const void*>(&reset_player),
    reinterpret_cast<const void*>(0x8d57d408), reinterpret_cast<const void*>(0x8d57d3e4),
    reinterpret_cast<const void*>(&all_off), reinterpret_cast<const void*>(&active),
    reinterpret_cast<const void*>(0x8d57d3fc), reinterpret_cast<const void*>(&step_player),
    reinterpret_cast<const void*>(0x8d57d3cc), reinterpret_cast<const void*>(0x8d57d3c0)
};
}
static const opxy::platform::Player player = {@PREFIX@_player_id, "@NAME@", @PREFIX@_player_vtable, @PAGE@, @PAGE_READY@, {@STEPS@}};
const opxy::platform::Player* @PREFIX@_player() { return &player; }
@PAGE_UNIT@
