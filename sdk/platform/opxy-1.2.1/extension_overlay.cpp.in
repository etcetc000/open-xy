// The SDK's overlay on every page: a screen object in the last page slot
// (@PAGE_LIMIT@ - 1), which no machine is given. The compositor (8d5213f4)
// paints a slot that is the current page, or whose method-table entry +8 says
// so; stock overlays such as the octave indicator use that. This object answers
// yes while an extension's layer is open (extension.hpp, Layer), and paints that
// extension's own nodes (its layer.svg.fragment, in openxy_overlay.svg) as its
// draw hook places them, over whatever page is shown.
#include "screen.hpp"
#include "registration.hpp"
#include "../extension_runtime.hpp"

using opxy::u32;
using opxy::i32;

namespace {
using namespace opxy::screen;
namespace platform = opxy::platform;

const u32 kPage = @PAGE_LIMIT@ - 1;
const char kAsset[] = "openxy_overlay.svg";
// Every extension's layer nodes, in collection order; each collection entry
// names its own first node and count (ExtensionEntry).
const u32 kNodes = @LAYER_NODES@;
const char* const kIds[kNodes + 1] = {
@LAYER_IDS@    nullptr};
struct Range { u32 first, count, opening; };
const u32 kNone = ~0u;
// The open layer's nodes, or none.
Range open_layer() {
    Range r = {0, 0, 0};
    return platform::extensions_layer_open(r.first, r.count, r.opening) && r.count && r.first + r.count <= kNodes
        ? r : Range{0, 0, 0};
}
const i32 kAway = 640 << 10;

struct Object {
    Base base;
    Leaf* nodes[kNodes + 1];   // each node, any kind; null until bound or when missing
    i32 home[kNodes + 1][2];   // each node's own translation, as loaded
    u32 bound;
    u32 drawn;                 // the first node of the layer that may show, or kNone
    u32 opening;               // the layer's opening those nodes were drawn for
    bool fresh;                // as loaded, every node shows: the first frame hides them
};
Object overlay;

// A node at its own place moved by (dx, dy) pixels, or off screen.
void place(Object* o, u32 i, bool on, i32 dx, i32 dy) {
    Leaf* node = o->nodes[i];
    if (!node) return;
    const u32 at[2] = {6, 7};
    const i32 value[2] = {o->home[i][0] + (on ? dx * 1024 : kAway), o->home[i][1] + (on ? dy * 1024 : 0)};
    set_words(node, at, value);
}
void hide_all(Object* o) {
    for (u32 i = 0; i < kNodes; ++i) place(o, i, false, 0, 0);
}

// The canvas an extension paints with: its own node numbers, checked.
struct Painter { Object* o; Range range; };
void show_node(void* self, u32 node, bool on, i32 dx, i32 dy) {
    const Painter* p = static_cast<const Painter*>(self);
    if (node < p->range.count) place(p->o, p->range.first + node, on, dx, dy);
}
void write_text(void* self, u32 node, const char* value) {
    const Painter* p = static_cast<const Painter*>(self);
    if (node >= p->range.count || !value) return;
    char text[32];
    u32 n = 0;
    while (n < 31 && value[n]) { text[n] = value[n]; ++n; }
    text[n] = 0;
    if (Leaf* leaf = text_node(p->o->nodes[p->range.first + node])) set_text(leaf, text);
}

void bind(Object* o) {
    if (o->bound || !o->base.svg) return;
    for (u32 i = 0; i < kNodes; ++i) {
        o->nodes[i] = static_cast<Leaf*>(find(&o->base, kIds[i]));
        if (o->nodes[i] && !path_node(o->nodes[i]) && !text_node(o->nodes[i])) o->nodes[i] = nullptr;
        o->home[i][0] = o->nodes[i] ? o->nodes[i]->matrix[6] : 0;
        o->home[i][1] = o->nodes[i] ? o->nodes[i]->matrix[7] : 0;
    }
    o->bound = 1;
    o->fresh = true;
    o->drawn = kNone;
}

void destroy(Object* o) { base_destroy(&o->base); }
// Entry +8: paint this slot now: while a layer is open, and one frame after it
// closes, to hide what it showed.
u32 visible(Object* o, u32) {
    // Unbound (its artwork not loaded yet), it is framed only while a layer is
    // open, which tries again to bind it.
    if (!o->bound) return open_layer().count != 0;
    return open_layer().count || o->drawn != kNone || o->fresh;
}
void frame(Object* o, i32 elapsed) {
    bind(o);
    const Range layer = open_layer();
    const bool open = layer.count != 0;
    if (o->bound && (o->fresh || o->drawn != (open ? layer.first : kNone) || (open && o->opening != layer.opening))) {
        hide_all(o);
        o->fresh = false;
        o->drawn = open ? layer.first : kNone;
        o->opening = layer.opening;
    }
    if (open) {
        // Frame time arrives in 1/1024 s; a layer counts milliseconds.
        platform::extensions_layer_frame(elapsed > 0 ? static_cast<u32>(elapsed) * 1000 / 1024 : 0);
        Painter painter = {o, layer};
        const opxy::extensions::Canvas canvas = {&painter, show_node, write_text};
        if (o->bound) platform::extensions_layer_draw(canvas);
    }
    draw(&o->base);
}
void init(Object* o) { bind(o); }

struct VTable {
    void (*destroy)(Object*);
    void (*destroy_delete)(Object*);
    u32 (*visible)(Object*, u32);
    void (*frame)(Object*, i32);
    void (*init)(Object*);
    const void* stock20;
};
const VTable kVTable = {destroy, destroy, visible, frame, init, reinterpret_cast<const void*>(0x8c0867f0)};

char* construct(char* state, u32 page) {
    Object* o = reinterpret_cast<Object*>(state);
    base_construct(&o->base, page, kAsset);
    o->base.vtable = &kVTable;
    return state;
}
}

// GUI role, after the machines' screens: startup calls it only in a build that
// links extensions; without a layer among them, it takes no slot.
extern "C" void sdk_overlay_startup() {
    if (!kNodes) return;
    const platform::Record record = {nullptr, nullptr, nullptr, nullptr, reinterpret_cast<const char*>(kPage), 0};
    const platform::Screen screen = {reinterpret_cast<char*>(&overlay), sizeof(overlay),
                                     reinterpret_cast<const char*>(&kVTable), kAsset, construct};
    sdk_register_screen(&record, &screen);
}
