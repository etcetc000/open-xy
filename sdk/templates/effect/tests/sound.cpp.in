// The machine's own sound checks, compiled for the host and run by
// python sdk.py test --machine <folder>. Extend them as the sound grows.
#include "../fx.cpp"
#include <cstdio>

int main() {
    static @ID@::State state;
    @ID@::initialize(state);
    opxy::i32 left[opxy::block_frames], right[opxy::block_frames];
    const opxy::i32 parameters[8] = {0x7fffffff, 0x7fffffff, 0x7fffffff};
    // Full-scale input at full drive, then silence: the output stays in range
    // and silence in gives silence out.
    for (unsigned block = 0; block < 64; ++block) {
        for (unsigned i = 0; i < opxy::block_frames; ++i) {
            left[i] = block < 32 ? (i & 1 ? 0x7fffffff : -0x7fffffff - 1) : 0;
            right[i] = left[i] / 3;
        }
        @ID@::process(state, left, right, parameters);
        for (unsigned i = 0; i < opxy::block_frames; ++i)
            if (block >= 32 && (left[i] || right[i])) {
                std::puts("FAIL sound out of silence");
                return 1;
            }
    }
    return 0;
}
