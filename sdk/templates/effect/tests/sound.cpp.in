// The machine's own sound checks, compiled for the host and run by
// python sdk.py test --machine <folder>. Extend them as the sound grows.
#include "../fx.cpp"
#include <cstdio>

int main() {
    static @ID@::State state;
    @ID@::initialize(state);
    opxy::i32 left[opxy::block_frames], right[opxy::block_frames];
    const opxy::i32 parameters[8] = {0x7fffffff, 0x7fffffff, 0x7fffffff};
    // Full-scale input at full drive, then silence: the drive keeps each
    // sample's sign (a wrapped peak would flip it), and silence in gives
    // silence out.
    for (unsigned block = 0; block < 64; ++block) {
        opxy::i32 in_left[opxy::block_frames], in_right[opxy::block_frames];
        for (unsigned i = 0; i < opxy::block_frames; ++i) {
            in_left[i] = left[i] = block < 32 ? (i & 1 ? 0x7fffffff : -0x7fffffff - 1) : 0;
            in_right[i] = right[i] = left[i] / 3;
        }
        @ID@::process(state, left, right, parameters);
        for (unsigned i = 0; i < opxy::block_frames; ++i) {
            const bool flipped = (left[i] < 0 && in_left[i] > 0) || (left[i] > 0 && in_left[i] < 0) ||
                                 (right[i] < 0 && in_right[i] > 0) || (right[i] > 0 && in_right[i] < 0);
            if (flipped || (block >= 4 && block < 32 && !left[i])) {
                std::puts("FAIL the drive changes a sample's sign or drops it");
                return 1;
            }
            if (block >= 32 && (left[i] || right[i])) {
                std::puts("FAIL sound out of silence");
                return 1;
            }
        }
    }
    return 0;
}
