{
  "about": "Shared by tests/test_machine_pack.py (tooling.machine_pack.variant_build) and tests/test_browser_kit.mjs (builder/core.mjs variantBuild): what a site's SDK objects must be built with for a pack's machines, given the site's build record, what its variants carry, the pack's build record and each pack machine's needs.",
  "cases": [
    {
      "name": "a synth adding nothing keeps the site's build",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": ["amp_envelope", "kit_controls", "played_pad"], "defines": ["-DOPXY_KIT_CONTROLS=1", "-DOPXY_PLAYER_INSTRUMENT=1"], "headers": ["control_interaction"]},
      "pack": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "machines": [{"kind": "synth", "services": [], "defines": [], "headers": []}],
      "expected": {"target": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}}}
    },
    {
      "name": "a player reading the instrument takes the carried player define, for every player",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": ["amp_envelope", "kit_controls", "played_pad"], "defines": ["-DOPXY_KIT_CONTROLS=1", "-DOPXY_PLAYER_INSTRUMENT=1"], "headers": ["control_interaction"]},
      "pack": {"services": ["drums", "octaves", "players", "samples"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": ["sample_kernel"], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}},
      "machines": [{"kind": "player", "services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": []},
                   {"kind": "player", "services": ["octaves", "players"], "defines": [], "headers": []}],
      "expected": {"target": {"services": ["drums", "octaves", "players", "samples"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": ["sample_kernel"], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}}}
    },
    {
      "name": "an older player built with the player define by another collection is refused",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": []},
      "pack": {"services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": [], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}},
      "machines": [{"kind": "player", "services": ["octaves", "players"], "defines": [], "headers": []}],
      "expected": {"refused": [0, "own", "player"]}
    },
    {
      "name": "an older player built without the define is refused beside one that adds it",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": []},
      "pack": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "machines": [{"kind": "player", "services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": []}],
      "expected": {"refused": [0, "own", "player"]}
    },
    {
      "name": "an older player is refused by a site whose players have the define",
      "site": {"services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": [], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}},
      "carried": {"services": [], "defines": [], "headers": []},
      "pack": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "machines": [{"kind": "player", "services": ["octaves", "players"], "defines": [], "headers": []}],
      "expected": {"refused": [0, "own", "player"]}
    },
    {
      "name": "a synth ignores the player define its author's collection compiled players with",
      "site": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": [], "headers": []},
      "pack": {"services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": [], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}},
      "machines": [{"kind": "synth", "services": [], "defines": [], "headers": []}],
      "expected": {"target": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}}}
    },
    {
      "name": "a player define the site does not carry is refused",
      "site": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": [], "headers": ["control_interaction"]},
      "pack": {"services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": [], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}},
      "machines": [{"kind": "player", "services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": []}],
      "expected": {"refused": [0, "define", "-DOPXY_PLAYER_INSTRUMENT=1"]}
    },
    {
      "name": "a kit with the drum-kit controls, an amp envelope and a played-pad screen takes the carried services and define",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": ["amp_envelope", "kit_controls", "played_pad"], "defines": ["-DOPXY_KIT_CONTROLS=1", "-DOPXY_PLAYER_INSTRUMENT=1"], "headers": ["control_interaction"]},
      "pack": {"services": ["amp_envelope", "drums", "kit_controls", "octaves", "played_pad", "players", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1"], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "machines": [{"kind": "drum", "services": ["amp_envelope", "drums", "kit_controls", "octaves", "played_pad", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1"], "headers": []}],
      "expected": {"target": {"services": ["amp_envelope", "drums", "kit_controls", "octaves", "played_pad", "players", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1"], "headers": ["sample_kernel"], "unitDefines": {"player": []}}}
    },
    {
      "name": "a kit needing a service the site neither links nor carries is refused",
      "site": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": ["control_interaction"]},
      "pack": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "machines": [{"kind": "drum", "services": ["drums", "octaves", "samples"], "defines": [], "headers": []}],
      "expected": {"refused": [0, "service", "drums"]}
    },
    {
      "name": "a synth reading the last control touched takes the carried header",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": [], "headers": ["control_interaction"]},
      "pack": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["control_interaction", "sample_kernel"], "unitDefines": {"player": []}},
      "machines": [{"kind": "synth", "services": [], "defines": [], "headers": ["control_interaction"]}],
      "expected": {"target": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["control_interaction", "sample_kernel"], "unitDefines": {"player": []}}}
    },
    {
      "name": "a header-tied unit the site neither links nor carries is refused",
      "site": {"services": ["octaves", "players"], "defines": [], "headers": [], "unitDefines": {"player": []}},
      "carried": {"services": [], "defines": [], "headers": ["control_interaction"]},
      "pack": {"services": ["octaves", "players"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "machines": [{"kind": "sample", "services": [], "defines": [], "headers": ["sample_kernel"]}],
      "expected": {"refused": [0, "header", "sample_kernel"]}
    },
    {
      "name": "everything at once: the defines in build order, the headers sorted",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": ["amp_envelope", "kit_controls", "played_pad"], "defines": ["-DOPXY_KIT_CONTROLS=1", "-DOPXY_PLAYER_INSTRUMENT=1", "-DOPXY_MODEL_EDIT=1"], "headers": ["control_interaction"]},
      "pack": {"services": ["amp_envelope", "drums", "kit_controls", "octaves", "played_pad", "players", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1", "-DOPXY_PLAYER_INSTRUMENT=1", "-DOPXY_MODEL_EDIT=1"], "headers": ["control_interaction", "sample_kernel"], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}},
      "machines": [{"kind": "synth", "services": [], "defines": [], "headers": ["control_interaction"]},
                   {"kind": "drum", "services": ["drums", "kit_controls", "octaves", "played_pad", "samples"], "defines": ["-DOPXY_MODEL_EDIT=1", "-DOPXY_KIT_CONTROLS=1"], "headers": []},
                   {"kind": "player", "services": ["octaves", "players"], "defines": ["-DOPXY_PLAYER_INSTRUMENT=1"], "headers": []}],
      "expected": {"target": {"services": ["drums", "kit_controls", "octaves", "played_pad", "players", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1", "-DOPXY_PLAYER_INSTRUMENT=1", "-DOPXY_MODEL_EDIT=1"], "headers": ["control_interaction", "sample_kernel"], "unitDefines": {"player": ["-DOPXY_PLAYER_INSTRUMENT=1"]}}}
    },
    {
      "name": "the first machine needing what the site lacks is named",
      "site": {"services": ["drums", "octaves", "players", "samples"], "defines": [], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "carried": {"services": ["played_pad"], "defines": [], "headers": []},
      "pack": {"services": ["drums", "kit_controls", "octaves", "played_pad", "players", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1"], "headers": ["sample_kernel"], "unitDefines": {"player": []}},
      "machines": [{"kind": "drum", "services": ["drums", "octaves", "played_pad", "samples"], "defines": [], "headers": []},
                   {"kind": "drum", "services": ["drums", "kit_controls", "octaves", "samples"], "defines": ["-DOPXY_KIT_CONTROLS=1"], "headers": []}],
      "expected": {"refused": [1, "service", "kit_controls"]}
    }
  ]
}
